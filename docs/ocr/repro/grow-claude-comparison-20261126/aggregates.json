  "strategyRecommendations": [
    {
      "use": "QHD、FHD 原生桌機基線",
      "candidate": "Grow38",
      "why": "可展開遊戲區，保留 Grow24 控制器。FHD 與 QHD 自然探索各自有兩版各四局。"
    },
    {
      "use": "958×557 窄畫布對照",
      "candidate": "Grow39",
      "why": "以短期軌跡結合主畫面體型；曾在 v2.13 有兩勝，v2.22 四局無勝。"
    },
    {
      "use": "歷史 v2.22 過關參照",
      "candidate": "Claude11",
      "why": "在 Claude11／21 當期觀察到 1/20，該次 141 秒。"
    },
    {
      "use": "短期避牆診斷",
      "candidate": "Claude22",
      "why": "從 Claude20 延伸，只新增 1.5 秒避牆項；此處窄畫布固定種子四局皆存活至截止。"
    },
    {
      "use": "QHD v2.22 捕食收益候選",
      "candidate": "Grow44",
      "why": "在 Grow38 的 v2.22 兩段規劃中移用兩秒可接觸 NPC 收益；它同時出現在舊 Grow6 planGrow 及 Claude1–4 planClaude，Claude22 的避牆是另一項機制。"
    }
  ],
